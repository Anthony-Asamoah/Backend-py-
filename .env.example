# DATABASE
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# APP
APP_TITLE="FastDjango"
APP_DESCRIPTION="The Best of Both Frameworks at your service."
APP_VERSION=0.0.1
APP_HOST=localhost
APP_PORT=8000
APP_RELOAD=True
API_PREFIX=/api/v1
DOCS_URL=/docs
ALLOWED_HOSTS=*
SECRET_KEY=
LOG_LEVEL=20

# Throttling
RATE_LIMIT=10
TIME_WINDOW=3

# STORAGE
STORAGE_TYPE=LOCAL
MEDIA_ROOT=media/

# DOCKER & DEPLOYMENT (Production)
# Domain for your API (used by Traefik)
DOMAIN=api.example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard domain
TRAEFIK_DOMAIN=traefik.example.com

# Traefik dashboard basic auth (generate with: htpasswd -nb admin password)
TRAEFIK_BASIC_AUTH=admin:$$apr1$$8EVjn/nj$$GiLUZqcbueTFeD23SuB6x0

# Traefik log level (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO
