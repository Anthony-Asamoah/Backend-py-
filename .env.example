# DATABASE
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# APP
APP_TITLE="FastDjango"
APP_DESCRIPTION="The Best of Both Frameworks at your service."
APP_VERSION=0.0.1
APP_HOST=localhost
APP_PORT=8000
APP_RELOAD=True
API_PREFIX=/api/v1
DOCS_URL=/docs
ALLOWED_HOSTS=*
SECRET_KEY=
LOG_LEVEL=20

# Throttling
RATE_LIMIT=10
TIME_WINDOW=3

# CACHE
CACHE_SERVICE=inmem # Options: 'inmem' or 'redis'

# Redis Configuration (only needed if CACHE_SERVICE=redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# STORAGE
STORAGE_TYPE=LOCAL
MEDIA_ROOT=media/

# DOCKER & DEPLOYMENT (Production)
# Domain for your API (used by Traefik)
DOMAIN=api.example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard domain
TRAEFIK_DOMAIN=traefik.example.com

# Traefik dashboard basic auth (generate with: htpasswd -nb admin password)
TRAEFIK_BASIC_AUTH=admin:$$apr1$$8EVjn/nj$$GiLUZqcbueTFeD23SuB6x0

# Traefik log level (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

# AUTH
JWT_SECRET_KEY=****
JWT_PRIVATE_KEY=****
JWT_PUBLIC_KEY=****
JWT_REFRESH_KEY=****
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
ACCESS_TOKEN_EXPIRES_IN_MINUTES=60
REFRESH_TOKEN_EXPIRES_IN_MINUTES=1440